{
  "schemaVersion": 1,
  "specVersion": "1.3.0",
  "sdkVersion": "0.5.0",
  "recipeSource": "design/color-recipe.js",
  "default": {
    "seed": "#614578",
    "mood": "calm"
  },
  "roleCount": 45,
  "largeAreaChroma": {
    "surface": 6,
    "navigation": 10,
    "topbar": 8,
    "softContainers": 16,
    "feedbackContainers": 12
  },
  "grid": {
    "contentMax": 1480,
    "gutter": "responsive",
    "gap": 24,
    "compactGap": 16,
    "shellHeight": 76,
    "compactShellHeights": [
      66,
      62
    ]
  },
  "focus": {
    "text": "bottom-integrated-2px",
    "action": "visible-perimeter",
    "highContrast": "system-visible-boundary"
  },
  "scrolling": {
    "independent": true,
    "containChaining": true,
    "scrollbars": "host-platform-policy"
  },
  "nativeDynamicColors": "Import full paired colors from canonical recipe export; no approximation using platform color generators.",
  "icons": {
    "viewBox": 24,
    "strokeWidth": 1.6,
    "headerSize": 20
  },
  "shape": {
    "source": "design/tokens.json#/radius",
    "control": 8,
    "content": 12,
    "dialog": 20,
    "pill": 999,
    "nested": "Subtract the actual inset when inner and outer shapes are visually concentric.",
    "drawerEdge": "no perimeter stroke; use surface and shadow",
    "exceptions": [
      "brand artwork",
      "functional circles",
      "capsule tracks",
      "miniature diagrams"
    ],
    "compactDerivative": "20px square checkbox: control × 0.5 = 4px; preserve visual distinction from a radio circle.",
    "toolbarPreferences": {
      "outer": "content",
      "inset": 2,
      "inner": "outer minus inset",
      "rule": "Equal-height language and appearance controls share one outer silhouette in every navigation context."
    }
  }
}
