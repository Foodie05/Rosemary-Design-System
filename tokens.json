{
  "name": "Rosemary Design Tokens",
  "version": "1.1.1-draft",
  "status": "设计提案；不是生产组件库",
  "themes": {
    "light": {
      "canvas": "#F8F7FB",
      "surface": "#FFFFFF",
      "raised": "#FFFFFF",
      "ink": "#302B3B",
      "muted": "#706579",
      "border": "#DED8E5",
      "control": "#8D8198",
      "primary": "#614578",
      "on-primary": "#FFFFFF",
      "primary-soft": "#E8E1F0",
      "sun": "#F3CD6B",
      "on-sun": "#513F13",
      "sky": "#DDEBF6",
      "on-sky": "#34516C",
      "success": "#2F6952",
      "success-soft": "#EAF4EE",
      "warning": "#815300",
      "warning-soft": "#FBF0D9",
      "danger": "#A53C46",
      "danger-soft": "#FBECEE",
      "on-danger": "#FFFFFF",
      "info": "#315F9A",
      "info-soft": "#EAF1FC",
      "focus": "#745291"
    },
    "dark": {
      "canvas": "#1C1922",
      "surface": "#25212D",
      "raised": "#302A39",
      "ink": "#F0EAF6",
      "muted": "#B9AEC6",
      "border": "#43394F",
      "control": "#94859F",
      "primary": "#CDB5EA",
      "on-primary": "#2D2038",
      "primary-soft": "#3C2F4C",
      "sun": "#E4C16B",
      "on-sun": "#3E3010",
      "sky": "#2B4256",
      "on-sky": "#D9EBFB",
      "success": "#9DD5B5",
      "success-soft": "#213D30",
      "warning": "#EBC97C",
      "warning-soft": "#44371C",
      "danger": "#F1ADB6",
      "danger-soft": "#452830",
      "on-danger": "#30171D",
      "info": "#AAC9EF",
      "info-soft": "#253B57",
      "focus": "#CDB5EA"
    }
  },
  "typography": {
    "ui": "-apple-system, BlinkMacSystemFont, Segoe UI, PingFang SC, Microsoft YaHei, sans-serif",
    "editorial": "Songti SC, STSong, Noto Serif CJK SC, Georgia, serif",
    "latinEditorial": "Georgia, Times New Roman, serif",
    "code": "SFMono-Regular, Consolas, Liberation Mono, monospace",
    "webScalePx": {
      "caption": 12,
      "small": 14,
      "body": 16,
      "lead": 20,
      "heading": 28,
      "title": 40,
      "display": 64
    },
    "lineHeight": {
      "body": 1.75,
      "compact": 1.5,
      "heading": 1.3
    }
  },
  "spacePx": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "radiusPx": {
    "control": 8,
    "content": 12,
    "dialog": 20,
    "pill": 999
  },
  "motionMs": {
    "instantFeedback": 120,
    "state": 180,
    "transition": 260,
    "exit": 160,
    "layout": 240,
    "confirmation": 220,
    "restoration": 480
  },
  "motionEasing": "cubic-bezier(0.2, 0.7, 0.2, 1)",
  "rules": {
    "nativePlatforms": "优先采用平台原生文本角色、控件与交互，不照搬 Web 像素",
    "border": "border 只用于辅助分隔；必要控件边界使用 control 并按实际背景验证",
    "sun": "日光黄是情感与装饰强调，不代替警告色，不单独承载状态",
    "accessibility": "这些变量不是完整可及性认证；真实组合、透明叠加与状态仍需测试"
  },
  "components": {
    "button": {
      "heightPx": {
        "small": 32,
        "medium": 40,
        "large": 48
      },
      "touchTargetPx": 44
    },
    "input": {
      "heightPx": 44,
      "borderRole": "control",
      "focusRole": "focus"
    },
    "icon": {
      "viewBox": 24,
      "strokeWidth": 1.6,
      "sizesPx": [
        16,
        20,
        24,
        32
      ]
    },
    "loading": {
      "sizesPx": [
        18,
        32,
        48
      ],
      "cycleMs": 1200,
      "appearanceDelayMs": 300,
      "reducedMotion": "static"
    },
    "dialog": {
      "radiusRole": "dialog",
      "enterMs": 260,
      "exitMs": 160
    },
    "progress": {
      "transitionMs": 320,
      "reducedMotion": "immediate",
      "valueSemantics": "actual-completed-work"
    }
  }
}
