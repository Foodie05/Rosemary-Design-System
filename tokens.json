      "surface-inset": "#322F33",
      "surface-floating": "#3B383C",
      "field-fill": "#373437",
      "field-hover": "#3E3A3E",
      "field-line": "#AFAAAE",
      "field-line-hover": "#C5BFC4",
      "edge-soft": "#575458",
      "secondary-container": "#463742",
      "on-secondary-container": "#FAD9F0",
      "tertiary-container": "#4A372B",
      "on-tertiary-container": "#FFDCC7",
      "success": "#97D5A5",
      "success-soft": "#2F3730",
      "warning": "#F3C666",
      "warning-soft": "#3B3428",
      "danger": "#FFB4AB",
      "danger-soft": "#403130",
      "info": "#98CCF9",
      "info-soft": "#30353B",
      "on-danger": "#540003"
    }
  },
  "typography": {
    "ui": "-apple-system, BlinkMacSystemFont, Segoe UI, PingFang SC, Microsoft YaHei, sans-serif",
    "editorial": "Songti SC, STSong, Noto Serif CJK SC, Georgia, serif",
    "latinEditorial": "Georgia, Times New Roman, serif",
    "code": "SFMono-Regular, Consolas, Liberation Mono, monospace",
    "webScalePx": {
      "caption": 12,
      "small": 14,
      "body": 16,
      "lead": 20,
      "heading": 28,
      "title": 40,
      "display": 64
    },
    "lineHeight": {
      "body": 1.75,
      "compact": 1.5,
      "heading": 1.3
    }
  },
  "spacePx": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "radiusPx": {
    "control": 8,
    "content": 12,
    "dialog": 20,
    "pill": 999
  },
  "motionMs": {
    "instantFeedback": 120,
    "state": 180,
    "transition": 260,
    "exit": 160,
    "layout": 240,
    "confirmation": 220,
    "restoration": 480,
    "page": 220
  },
  "motionEasing": "cubic-bezier(0.2, 0.7, 0.2, 1)",
  "rules": {
    "nativePlatforms": "优先采用平台原生文本角色、控件与交互，不照搬 Web 像素",
    "border": "border 只用于辅助分隔；必要控件边界使用 control 并按实际背景验证",
    "sun": "日光黄是情感与装饰强调，不代替警告色，不单独承载状态",
    "accessibility": "这些变量不是完整可及性认证；真实组合、透明叠加与状态仍需测试"
  },
  "components": {
    "button": {
      "heightPx": {
        "small": 32,
        "medium": 40,
        "large": 48
      },
      "touchTargetPx": 44
    },
    "input": {
      "heightPx": 44,
      "borderRole": "control",
      "focusRole": "focus"
    },
    "icon": {
      "viewBox": 24,
      "strokeWidth": 1.6,
      "sizesPx": [
        16,
        20,
        24,
        32
      ]
    },
    "loading": {
      "sizesPx": [
        18,
        32,
        48
      ],
      "cycleMs": 1200,
      "appearanceDelayMs": 300,
      "reducedMotion": "static"
    },
    "dialog": {
      "radiusRole": "dialog",
      "enterMs": 260,
      "exitMs": 160
    },
    "progress": {
      "transitionMs": 320,
      "reducedMotion": "immediate",
      "valueSemantics": "actual-completed-work"
    },
    "tabs": {
      "indicatorMs": 180,
      "contentMs": 180,
      "reducedMotion": "immediate"
    }
  }
}
