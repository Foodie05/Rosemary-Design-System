{
  "name": "rosemary-design-system",
  "private": true,
  "version": "2.0.0-beta.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run tokens:build && npm run guide:build && npm run native:package && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "test": "vitest run --reporter=default --reporter=json --outputFile=docs/test-results.json",
    "check": "node scripts/check-web.mjs",
    "evidence": "node scripts/build-acceptance.mjs",
    "check:native": "node scripts/check-native.mjs",
    "guide:build": "tsx scripts/build-guide.mjs",
    "native:package": "node scripts/package-native.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
